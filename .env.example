# Copy to .env locally. Never commit real credentials.
RESEND_API_KEY=
# A sender address accepted by your Resend account; verify its domain as required.
RESEND_FROM=
# Keep this stable when reconciling or retrying the same test email.
RESEND_OPERATION_ID=permission-lab-test-001
# Optional. Defaults to resend-study.sqlite in the current directory.
PILOT_DATABASE=resend-study.sqlite
